{
  "name": "minimal-mistakes",
  "private": true,
  "version": "4.24.0",
  "description": "Minimal Mistakes 2 column Jekyll theme.",
  "repository": {
    "type": "git",
    "url": "git://github.com/mmistakes/minimal-mistakes.git"
  },
  "keywords": [
    "jekyll",
    "theme",
    "minimal"
  ],
  "author": "Michael Rose",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mmistakes/minimal-mistakes/issues"
  },
  "homepage": "https://mmistakes.github.io/minimal-mistakes/",
  "engines": {
    "node": ">= 0.10.0"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "onchange": "^7.1.0",
    "uglify-js": "^3.13.6"
  },
  "scripts": {
    "uglify": "uglifyjs jekyll/assets/js/vendor/jquery/jquery-3.5.1.js jekyll/assets/js/plugins/jquery.fitvids.js jekyll/assets/js/plugins/jquery.greedy-navigation.js jekyll/assets/js/plugins/jquery.magnific-popup.js jekyll/assets/js/plugins/jquery.ba-throttle-debounce.js jekyll/assets/js/plugins/smooth-scroll.js jekyll/assets/js/plugins/gumshoe.js jekyll/assets/js/_main.js -c -m -o jekyll/assets/js/main.min.js",
    "add-banner": "node banner.js",
    "watch:js": "onchange \"assets/js/**/*.js\" -e \"assets/js/main.min.js\" -- npm run build:js",
    "build:js": "npm run uglify && npm run add-banner",
    "load": "jekyll serve --livereload"
  },
  "dependencies": {
    "minimal-mistakes": "file:"
  }
}
