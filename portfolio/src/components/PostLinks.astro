---
import type { FeaturedPost } from '../types';

interface Props {
  posts: FeaturedPost[];
  heading?: string;
}

const { posts, heading = 'Escritura destacada' } = Astro.props;
---

{posts.length > 0 && (
  <section class="max-w-5xl mx-auto px-4 py-12 border-t border-white/10">
    <h2 class="text-2xl font-semibold text-white mb-6">{heading}</h2>
    <ul class="space-y-4">
      {posts.map((post) => (
        <li class="rounded-lg border border-white/10 bg-card/50 p-4 hover:border-accent/40 transition-colors">
          <a href={post.url} class="block no-underline hover:no-underline group">
            <span class="text-white font-medium group-hover:text-accent">{post.title}</span>
            {post.excerpt && <p class="text-sm text-muted mt-1">{post.excerpt}</p>}
          </a>
        </li>
      ))}
    </ul>
  </section>
)}

{posts.length === 0 && (
  <section class="max-w-5xl mx-auto px-4 py-12 border-t border-white/10">
    <h2 class="text-2xl font-semibold text-white mb-4">{heading}</h2>
    <p class="text-muted text-sm">Próximamente — añadí posts con <code class="text-accent">categories: [poems]</code> en el blog Jekyll.</p>
  </section>
)}
