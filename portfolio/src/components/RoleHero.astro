---
import type { RoleData } from '../types';
import { LINKEDIN_URL } from '../types';

interface Props {
  role: RoleData;
}

const { role } = Astro.props;
---

<section class="max-w-5xl mx-auto px-4 py-16 md:py-24">
  <p class="text-accent font-mono text-sm mb-3 uppercase tracking-widest">{role.slug.replace(/-/g, ' ')}</p>
  <h1 class="text-4xl md:text-5xl font-bold text-white mb-4 leading-tight">{role.title}</h1>
  <p class="text-lg text-muted max-w-2xl mb-8">{role.tagline}</p>
  <div class="flex flex-wrap gap-3">
    {role.showProjects !== false && (
      <a
        href="#projects"
        class="inline-flex items-center px-5 py-2.5 rounded-lg bg-accent text-surface font-medium no-underline hover:no-underline hover:opacity-90"
      >
        Ver proyectos
      </a>
    )}
    <a
      href={LINKEDIN_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center px-5 py-2.5 rounded-lg border border-white/20 text-white no-underline hover:no-underline hover:border-accent"
    >
      LinkedIn
    </a>
  </div>
</section>
