---
interface Props {
  skills: string[];
}

const { skills } = Astro.props;
---

{skills.length > 0 && (
  <section class="max-w-5xl mx-auto px-4 py-12 border-t border-white/10">
    <h2 class="text-2xl font-semibold text-white mb-6">Skills</h2>
    <div class="flex flex-wrap gap-2">
      {skills.map((skill) => (
        <span class="px-3 py-1.5 rounded-full bg-white/5 border border-white/10 text-sm text-gray-200 font-mono">
          {skill}
        </span>
      ))}
    </div>
  </section>
)}
