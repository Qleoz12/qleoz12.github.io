---
import type { Project } from '../types';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

<section id="projects" class="max-w-5xl mx-auto px-4 py-12 border-t border-white/10 scroll-mt-20">
  <h2 class="text-2xl font-semibold text-white mb-2">Proyectos</h2>
  <p class="text-muted text-sm mb-8">Repos y herramientas que respaldan este perfil.</p>
  {projects.length > 0 ? (
    <div class="grid gap-4 md:grid-cols-2">
      {projects.map((project) => (
        <a
          href={project.url}
          target="_blank"
          rel="noopener noreferrer"
          class="block rounded-xl bg-card border border-white/10 p-6 no-underline hover:no-underline hover:border-accent/50 transition-colors group"
        >
          <h3 class="text-lg font-semibold text-white group-hover:text-accent">{project.name}</h3>
          <p class="text-sm text-muted mt-2">{project.description}</p>
          <div class="flex flex-wrap gap-2 mt-4">
            {project.tags.map((tag) => (
              <span class="text-xs font-mono text-accent/80">#{tag}</span>
            ))}
          </div>
        </a>
      ))}
    </div>
  ) : (
    <p class="text-muted text-sm">Sin proyectos listados para este rol.</p>
  )}
</section>
