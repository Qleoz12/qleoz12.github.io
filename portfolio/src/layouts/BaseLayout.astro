---
import '../styles/global.css';
import { BLOG_BASE } from '../types';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const { title, description = 'Leonardo L. Sanchez — portfolio por rol profesional.', noindex = false } = Astro.props;
const fullTitle = `${title} | Dann Brown`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title>{fullTitle}</title>
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="border-b border-white/10 bg-surface/90 backdrop-blur sticky top-0 z-50">
      <nav class="max-w-5xl mx-auto px-4 py-4 flex items-center justify-between gap-4">
        <a href={import.meta.env.BASE_URL} class="font-semibold text-white no-underline hover:no-underline">
          Dann Brown
        </a>
        <div class="flex flex-wrap gap-4 text-sm text-muted">
          <a href={import.meta.env.BASE_URL} class="no-underline hover:text-accent">Roles</a>
          <a href={`${BLOG_BASE}/experience/`} class="no-underline hover:text-accent">Experience</a>
          <a href={BLOG_BASE} class="no-underline hover:text-accent">Blog</a>
        </div>
      </nav>
    </header>
    <main class="flex-1">
      <slot />
    </main>
    <footer class="border-t border-white/10 py-8 text-center text-sm text-muted">
      <p>
        <a href={BLOG_BASE} class="no-underline hover:text-accent">Blog</a>
        ·
        <a href={`${BLOG_BASE}/about/`} class="no-underline hover:text-accent">About</a>
      </p>
    </footer>
  </body>
</html>
