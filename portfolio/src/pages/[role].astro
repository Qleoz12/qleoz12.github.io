---
import RoleLayout from '../layouts/RoleLayout.astro';
import RoleHero from '../components/RoleHero.astro';
import ExperienceList from '../components/ExperienceList.astro';
import SkillChips from '../components/SkillChips.astro';
import PostLinks from '../components/PostLinks.astro';
import ProjectsCTA from '../components/ProjectsCTA.astro';
import { loadAllRoles, loadProjects, projectsForRole } from '../lib/data';
import { EXPERIENCE_URL } from '../types';

export function getStaticPaths() {
  return loadAllRoles().map((role) => ({
    params: { role: role.slug },
    props: { role },
  }));
}

const { role } = Astro.props;
const projectsData = loadProjects();
const projects = projectsForRole(role.projectTags, projectsData);
const postsHeading = role.slug === 'poems' ? 'Poemas' : role.slug === 'finance' ? 'Publicaciones' : 'Escritura destacada';
---

<RoleLayout role={role}>
  <RoleHero role={role} />
  {role.showExperience !== false && <ExperienceList items={role.experience} />}
  <SkillChips skills={role.skills} />
  <PostLinks posts={role.featuredPosts} heading={postsHeading} />
  {role.showProjects !== false && <ProjectsCTA projects={projects} />}

  <section class="max-w-5xl mx-auto px-4 py-12 border-t border-white/10 mb-8">
    <p class="text-sm text-muted">
      {role.slug !== 'poems' && role.slug !== 'finance' && (
        <>
          CV detallado:
          <a href={EXPERIENCE_URL}> /experience/</a>
          ·
        </>
      )}
      <a href={import.meta.env.BASE_URL}>← Volver a roles</a>
    </p>
  </section>
</RoleLayout>
